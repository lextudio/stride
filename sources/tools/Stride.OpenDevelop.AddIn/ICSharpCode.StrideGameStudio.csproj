<Project Sdk="LibreWPF.Sdk">
  <!-- OpenDevelop's Stride Game Studio addin. Lives in the Stride repo (not OpenDevelop's) so
       everyday OpenDevelop development does not need a built Stride checkout - see
       OpenDevelop's doc/technotes/stride-game-studio.md. Mirrors the placement of
       sources/tools/Stride.VisualStudio.Package: a foreign-IDE integration, versioned and built
       independently of the engine, kept out of the engine solution filters. -->
  <PropertyGroup>
    <!-- Override point: where the OpenDevelop checkout lives. Everything OpenDevelop-side hangs
         off this one property - the compile-time references, the addin deployment folder, and the
         host bin folder that bare-name native loaders probe. -->
    <!-- The OPENDEVELOP_ROOT environment variable reaches evaluations this project cannot pass a
         -p: to, such as the hosting OpenDevelop reading StartArguments; without it the integration
         suite's parent host resolved no Addin SDK and saw empty StartArguments. -->
    <OpenDevelopRoot Condition="'$(OpenDevelopRoot)' == '' And '$(OPENDEVELOP_ROOT)' != ''">$([MSBuild]::EnsureTrailingSlash('$(OPENDEVELOP_ROOT)'))</OpenDevelopRoot>
    <OpenDevelopRoot Condition="'$(OpenDevelopRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../UnoDevelop/externals/OpenDevelop/'))</OpenDevelopRoot>
    <!-- A released OpenDevelop can be selected without copying this addin into it. The Addin SDK
         then starts that installed host with -addindir:$(OutputPath), which is also how the
         integration suite exercises the real external-addin debug loop. -->
    <OpenDevelopHostBin Condition="'$(OpenDevelopHostBin)' == '' And '$(OPENDEVELOP_APP_PATH)' != ''">$([System.IO.Path]::GetDirectoryName('$(OPENDEVELOP_APP_PATH)'))/</OpenDevelopHostBin>
    <OpenDevelopHostBin Condition="'$(OpenDevelopHostBin)' == ''">$(OpenDevelopRoot)src/Main/SharpDevelop/bin/$(Configuration)/net11.0-windows/</OpenDevelopHostBin>
    <!-- The Addin SDK trims this add-in's output by OpenDevelop.host-assemblies.txt (the host's own assembly names). OpenDevelop
         releases up to v5.9.1 do not ship it; use the copy next to this project (taken from v5.9.1) when the host directory has
         none. A host that ships its own list is always preferred. -->
    <OpenDevelopHostManifest Condition="'$(OpenDevelopHostManifest)' == '' And '$(OpenDevelopHostBin)' != '' And !Exists('$(OpenDevelopHostBin)OpenDevelop.host-assemblies.txt')">$(MSBuildThisFileDirectory)OpenDevelop.host-assemblies.txt</OpenDevelopHostManifest>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <!-- Test-only: exposes the SDK-started child on a second DevFlow port. An ordinary developer
         launch leaves this empty and therefore retains the SDK default -devflow:off. -->
    <OpenDevelopDebugDevFlowPort Condition="'$(OpenDevelopDebugDevFlowPort)' == '' And '$(OPENDEVELOP_ADDIN_TEST_DEVFLOW_PORT)' != ''">$(OPENDEVELOP_ADDIN_TEST_DEVFLOW_PORT)</OpenDevelopDebugDevFlowPort>
    <!-- OpenDevelopAppFixture supplies OD_TEST_MODE only to the integration-test parent host. -->
    <OpenDevelopDebugDevFlowPort Condition="'$(OpenDevelopDebugDevFlowPort)' == '' And '$(OD_TEST_MODE)' == '1'">9300</OpenDevelopDebugDevFlowPort>
    <TargetFramework>net11.0-windows</TargetFramework>
    <!-- The OpenDevelop host this add-in loads into is net11 (since 5.9), and its assemblies reference System.Runtime 11: the add-in has to
         target net11 to compile against them. The Stride projects it references stay net10; a net11 project can use those. -->
    <!-- The published LibreWPF closure ships lib/net10.0 only; LibreWPF.Sdk derives these folders from the TargetFramework, so pin them back (same block as OpenDevelop's Directory.Build.props). -->
    <_ProGpuWpfManagedTransportRuntimeTfm>net10.0</_ProGpuWpfManagedTransportRuntimeTfm>
    <_ProGpuWpfCanonicalWinFormsRuntimeTfm>net10.0</_ProGpuWpfCanonicalWinFormsRuntimeTfm>
    <_ProGpuWpfPortableWinFormsCompatRuntimeTfm>net10.0</_ProGpuWpfPortableWinFormsCompatRuntimeTfm>
    <RootNamespace>ICSharpCode.StrideGameStudio</RootNamespace>
    <AssemblyName>ICSharpCode.StrideGameStudio</AssemblyName>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <!-- Deploy straight into the OpenDevelop checkout's AddIns tree, exactly as before the move,
         so a developer's OpenDevelop picks the addin up with no extra step. -->
    <!-- StrideAddInDeployDir (an absolute path with a trailing slash) deploys somewhere else, for example to build the .odaddin release
         package without touching the OpenDevelop checkout. Not OutputPath itself: a global OutputPath would flow into every Stride project
         this one references and redirect all their outputs too. -->
    <OutputPath Condition="'$(StrideAddInDeployDir)' != ''">$(StrideAddInDeployDir)</OutputPath>
    <OutputPath Condition="'$(StrideAddInDeployDir)' == ''">$(OpenDevelopRoot)AddIns/DisplayBindings/StrideGameStudio/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Engine-repo conventions this project opts out of, same as Stride.VisualStudio.Package. -->
    <StrideAssemblyProcessor>false</StrideAssemblyProcessor>
    <StrideSkipAutoPack>true</StrideSkipAutoPack>
    <!-- The ProjectReferences below make MSBuild build ~15 Stride engine/editor projects as part
         of THIS project's own graph - something nothing in the Stride repo's own build ever did
         before (those projects were always built independently, then referenced as finished
         binaries). Building them together, in parallel, races Stride's own StrideAssemblyProcessor
         post-build IL step: Mono.Cecil's ModuleWriter.WriteModule threw "Unexpected error"
         non-deterministically (confirmed NOT a real defect - every one of those projects builds
         clean standalone, and the whole graph builds clean under -m:1). BuildInParallel is the
         project-local, no-external-flags-required way to force this graph sequential regardless of
         how `dotnet build`/`dotnet pack` is invoked. -->
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>
  <!-- OpenDevelop's Addin SDK is auto-imported for every project inside the OpenDevelop repo by
       its Directory.Build.targets; out here it has to be imported explicitly. Same pattern as
       Stride.VisualStudio.Package importing Stride.Build.Sdk by path. Guarded so the project
       still evaluates (and gives a clear reference error) when OpenDevelopRoot is wrong. -->
  <Import Project="$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.props"
          Condition="Exists('$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.props')" />
  <!-- No OpenDevelop source tree (a release build, CI): the same SDK files are part of every installed OpenDevelop, under Sdks/ next to the
       host assemblies. -->
  <Import Project="$(OpenDevelopHostBin)Sdks/OpenDevelop.Addin.Sdk/Sdk/Sdk.props"
          Condition="!Exists('$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.props') And Exists('$(OpenDevelopHostBin)Sdks/OpenDevelop.Addin.Sdk/Sdk/Sdk.props')" />
  <!-- OpenDevelopTrimAddinOutput (OpenDevelop.Addin.Sdk/Sdk/Sdk.targets) deletes any DLL from this
       addin's output whose filename also exists in the host app's own bin folder, assuming the
       host's copy is a safe substitute. That assumption breaks for NuGet.ProjectModel: the host
       app also ships a copy (for AddInManager2's own NuGet usage), but at a different version
       (7.6.0.0) than Stride's PackageSession.Dependencies needs (a strict strong-named load of
       exactly 7.3.1.0, confirmed via a FileNotFoundException naming that exact version) - so the
       host's copy is NOT interchangeable here. OpenDevelopAlwaysCopy is the Sdk's own escape
       hatch (matched by %(Filename), see the trim target) for exactly this situation. -->
  <ItemGroup>
    <OpenDevelopAlwaysCopy Include="NuGet.ProjectModel.dll" />
    <!-- Same version mismatch as NuGet.ProjectModel above: the host ships its own AvalonDock
         (for OpenDevelop's own docking UI) at a different version than Stride.GameStudio's
         AvalonDock 4.72.1.0, which Stride.Core.Assets.Editor's own WPF views need at that exact
         strong name. Confirmed via a live FileNotFoundException naming that exact version once
         the NuGet.ProjectModel fix let session loading get this far. -->
    <OpenDevelopAlwaysCopy Include="AvalonDock.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- OpenDevelop host assemblies. Private=false throughout: the host owns these types at
         runtime, and a second copy in the addin folder would be a different instance of the same
         types (addin discovery and [DevFlowAction] discovery would both stop matching).
         PackageReference, not HintPath: packed from OpenDevelop (`dotnet pack <project>
         -p:Version=5.2.0`, same version across the whole closure) so this project's COMPILE-TIME
         closure no longer needs $(OpenDevelopRoot) to point at an OpenDevelop source checkout -
         only $(OpenDevelopHostBin) (a built host OUTPUT) is still needed, and only at runtime
         (addin loading) and for the two host-bin HintPaths still below (DevFlow, and
         OpenDevelopDebugHost in the SDK). -->
    <!-- NU1107: OpenDevelop's own Roslyn closure (via ICSharpCode.SharpDevelop ->
         Microsoft.CodeAnalysis.CSharp.Features) needs 5.6.0, while Stride.Assets.Presentation's
         Microsoft.CodeAnalysis.CSharp.Scripting 5.3.0 pins Microsoft.CodeAnalysis.Scripting.Common
         to exactly (=) 5.3.0 - not a floor, so NuGet cannot auto-unify. Force the higher version
         directly, matching what OpenDevelop's own host actually runs (and what every other
         Microsoft.CodeAnalysis.* package here already resolves to). -->
    <PackageReference Include="Microsoft.CodeAnalysis.Scripting.Common" VersionOverride="5.6.0" />
    <!-- Reached transitively through ICSharpCode.SharpDevelop's public surface (RichText on the
         output/logging APIs). It came in for free while this project referenced
         ICSharpCode.SharpDevelop.csproj; against binaries it has to be named.
         A PackageReference, not a HintPath: once the engine-closure ProjectReferences below pull
         in real NuGet resolution (LibreWPF.ProGPU etc.), a transitive AvalonEdit dependency from
         THAT graph competes with a bare HintPath and NuGet's own resolved (older) version wins -
         CS1705 "uses a higher version than referenced assembly". An explicit PackageReference,
         pinned to the exact build OpenDevelop's host ships (packed to the local feed from
         src/Libraries/AvalonEdit/ICSharpCode.AvalonEdit), makes this the winning version instead
         of an accidental one. -->
    <!-- For the [DevFlowAction] diagnostics in StrideGameStudioDevFlowActions. Private=false: the
         host already loads this assembly (it runs the agent), and a second copy in the addin folder
         would be a different instance of the same attribute types, so discovery would not match. -->
    <!-- The OpenDevelop host assemblies this add-in compiles against, taken as built from OpenDevelopHostBin (an OpenDevelop
         release or installation) rather than from locally packed ICSharpCode.* packages, which exist nowhere a CI job could
         restore them from. Private=false: the host owns these types at run time. -->
    <Reference Include="$(OpenDevelopHostBin)ICSharpCode.*.dll;$(OpenDevelopHostBin)LeXtudio.OpenDevelop.ResourceFiles.dll;$(OpenDevelopHostBin)Xceed.Wpf.Toolkit.dll" Private="false" />
    <Reference Include="LeXtudio.DevFlow.Agent.Core">
      <HintPath>$(OpenDevelopHostBin)LeXtudio.DevFlow.Agent.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- Exposes $(StrideRoot) to runtime code as STRIDE_SOURCE_ROOT (see
       StrideEditorHost.cs's static constructor and StrideDefaultTemplates.Load's fork patch) -
       StrideDefaultTemplates.Load needs the source-tree location of Stride.Assets.Presentation/
       Stride.SpriteStudio.Offline's .sdpkg files, since this addin consumes Stride via raw file
       references rather than a NuGet-restored install that PackageStore could otherwise find. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>StrideCheckoutRoot</_Parameter1>
      <_Parameter2>$(StrideRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Stride editor assemblies from the local port clone (see
       doc/technotes/stride-game-studio.md). Deliberately MINIMAL for the fusion skeleton:
       only the asset core travels with the addin; scene-editor hosting layers join in later
       slices. Private=true so they deploy next to this addin's dll. -->
  <ItemGroup>
    <ProjectReference Include="..\..\core\Stride.Core\Stride.Core.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\assets\Stride.Core.Assets\Stride.Core.Assets.csproj"><Private>true</Private></ProjectReference>
    <!-- PackageVersion/UFile (touched by Meta.Version and AssetItem.Location) live here. -->
    <ProjectReference Include="..\..\core\Stride.Core.Design\Stride.Core.Design.csproj"><Private>true</Private></ProjectReference>
    <!-- Transitive NuGet dep of the Stride asset core that a ProjectReference does NOT pull in
         copy-local on its own (it is not one of THAT project's own outputs). Stride.Core.Assets'
         module initializer binds ServiceWire at first touch - missing it killed the view with a
         TypeInitializationException on open. Centrally versioned by sources/Directory.Packages.props
         (this project is under sources/, so it inherits that automatically) - stays in lock-step
         with Stride's own packages with no version to maintain here. -->
    <PackageReference Include="ServiceWire" />
  </ItemGroup>
  <!-- Engine closure for the LIVE viewport (fusion milestone 2). The headless Game renders a
       frame every tick; the presenter shows it. Private=true so they deploy next to this addin. -->
  <ItemGroup>
    <ProjectReference Include="..\..\engine\Stride.Engine\Stride.Engine.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\engine\Stride.Games\Stride.Games.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\engine\Stride.Graphics\Stride.Graphics.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\engine\Stride.Input\Stride.Input.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\engine\Stride.Rendering\Stride.Rendering.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\shaders\Stride.Shaders\Stride.Shaders.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\shaders\Stride.Shaders.Effects\Stride.Shaders.Effects.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\shaders\Stride.Shaders.Compilers\Stride.Shaders.Compilers.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\shaders\Stride.Shaders.Parsers\Stride.Shaders.Parsers.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\shaders\Stride.Shaders.Spirv\Stride.Shaders.Spirv.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\core\Stride.Core.IO\Stride.Core.IO.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\core\Stride.Core.Mathematics\Stride.Core.Mathematics.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\core\Stride.Core.MicroThreading\Stride.Core.MicroThreading.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\core\Stride.Core.Serialization\Stride.Core.Serialization.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\engine\Stride.Foundation\Stride.Foundation.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\engine\Stride.Audio\Stride.Audio.csproj"><Private>true</Private></ProjectReference>
    <ProjectReference Include="..\..\engine\Stride.VirtualReality\Stride.VirtualReality.csproj"><Private>true</Private></ProjectReference>
    <PackageReference Include="Vortice.Vulkan" />
    <!-- Not in sources/Directory.Packages.props (only pulled in transitively elsewhere in Stride's
         own graph) - VersionOverride is CPM's supported per-project escape hatch, so this stays a
         one-line override instead of adding an addin-only entry to the shared central file. -->
    <PackageReference Include="Silk.NET.Core" VersionOverride="2.23.0" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>
  <!-- Windowed viewport (supersedes the headless+readback route, see
       doc/technotes/stride-game-studio.md "G4 viewport stability/perf investigation" and
       "Composition-bridge probes"): GameContextSDL needs Silk.NET.SDL for SDL_GetWindowWMInfo,
       and the LibreWPF-side Cocoa NSWindow is obtained via LibreWPF.ProGPU's public diagnostics
       entry point (ProGpuWpfDiagnostics.TryGetWindowHost) + Silk.NET.Windowing's own
       INativeWindow.Cocoa. -->
  <ItemGroup>
    <!-- Centrally versioned as "Silk.NET.Sdl" (lowercase "dl") in sources/Directory.Packages.props;
         the package id itself is case-insensitive at restore, kept as "Silk.NET.SDL" here to match
         the assembly/type name used throughout this project's own code. -->
    <PackageReference Include="Silk.NET.SDL" />
    <PackageReference Include="Silk.NET.Windowing.Common" VersionOverride="2.23.0" />
    <PackageReference Include="LibreWPF.ProGPU" VersionOverride="0.1.0-preview.69" />
  </ItemGroup>
  <!-- Real-content integration (doc/technotes/stride-game-studio.md "Real-content integration
       plan"): SessionViewModel/EditorViewModel/AssetsPlugin/PluginService/StrideEditorPlugin, all
       reused as-is from Stride.GameStudio's own editor stack. These references are compile-time
       only (Private=false) - the ~50-assembly transitive closure (asset compiler, shader
       compiler, WPF transport, ...) is copied wholesale by CopyGameStudioEditorClosure below,
       the same "copy the whole bin folder next to ours" approach already proven for the engine
       closure, rather than hand-listing every transitive dependency. -->
  <ItemGroup>
    <!-- ProjectReference (not just compile-time-only HintPaths anymore) also fixes a real,
         previously-documented staleness trap: Stride.GameStudio's bin folder is the aggregation
         point CopyGameStudioEditorClosure copies wholesale below, so rebuilding a leaf project
         like Stride.Core.Assets without ALSO rebuilding Stride.GameStudio silently left this addin
         running yesterday's engine code (see the technote's "build trap" entry). A ProjectReference
         makes MSBuild build these in dependency order before this addin, every time - the trap can
         no longer happen by construction. -->
    <ProjectReference Include="..\..\editor\Stride.Core.Assets.Editor\Stride.Core.Assets.Editor.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="..\..\editor\Stride.Assets.Presentation\Stride.Assets.Presentation.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="..\..\editor\Stride.GameStudio\Stride.GameStudio.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="..\..\editor\Stride.Editor\Stride.Editor.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="..\..\presentation\Stride.Core.Presentation\Stride.Core.Presentation.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="..\..\presentation\Stride.Core.Presentation.Wpf\Stride.Core.Presentation.Wpf.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="..\..\core\Stride.Core.Translation\Stride.Core.Translation.csproj"><Private>false</Private></ProjectReference>
    <!-- SceneAsset (real entity/transform data for gap 2's viewport rendering) lives here. -->
    <ProjectReference Include="..\..\engine\Stride.Assets\Stride.Assets.csproj"><Private>false</Private></ProjectReference>
    <!-- PackageSession.UpdateDependencies (opening a session whose package has a referenced
         .csproj) touches NuGet.ProjectModel's LockFileFormat directly - not a compile-time
         reference of ours, so it needs its own explicit reference to land in this addin's output
         (Private=true, unlike the editor closure above). Centrally versioned at 7.3.1 in
         sources/Directory.Packages.props, which matches the exact strong name
         (7.3.1.0) Stride's own PackageSession.Dependencies needs - see the OpenDevelopAlwaysCopy
         note above for why the host's own, different-versioned copy cannot substitute for it. -->
    <PackageReference Include="NuGet.ProjectModel" />
  </ItemGroup>
  <Target Name="CopyStrideRuntimes" AfterTargets="Build">
    <ItemGroup>
      <StrideRt Include="$(StrideRoot)sources\engine\Stride.Engine\bin\$(Configuration)\net10.0\runtimes\**\*" />
      <!-- Stride.GameStudio targets net10.0-windows, so its own NuGet runtime-asset selection
           only pulls Windows-flavored "runtimes/*/native" folders (e.g. libbulletc.dll) even with
           RuntimeIdentifier unset on macOS - the osx-arm64 native asset only shows up in plain
           net10.0 (non-Windows-targeted) projects that consume the same native package, such as
           Stride.Physics's own bin output. Pull those in too so bulletc etc. resolve on macOS. -->
      <StrideRt Include="$(StrideRoot)sources\engine\Stride.Physics\bin\$(Configuration)\net10.0\runtimes\**\*" />
      <!-- Same TFM issue again for FFmpeg (avutil/avcodec/...) and every other native dep
           Stride.Assets.Presentation itself pulls in - its own (non-Windows-targeted-adjacent,
           but still net10.0-windows) bin folder DOES carry the full osx-arm64 native set though,
           since it builds directly against those NuGet packages. Superset of what's needed here
           (bulletc/freetype/etc. duplicate the sources above; SkipUnchangedFiles makes that free). -->
      <StrideRt Include="$(StrideRoot)sources\editor\Stride.Assets.Presentation\bin\$(Configuration)\net10.0-windows\runtimes\**\*" />
      <!-- ...and Stride.EffectCompilerServer's, which is a further superset: it is the only one
           carrying libstride_spirv_tools. Without it SpirvTools' static ctor throws on first shader
           compilation, EditorServiceGame catches that into Faulted, and from then on Update returns
           immediately - so every GameSystem stops (scene stays on screen, frame counter keeps
           climbing, no editor service ever runs again). -->
      <StrideRt Include="$(StrideRoot)sources\tools\Stride.EffectCompilerServer\bin\$(Configuration)\net10.0-windows\runtimes\**\*" />
      <!-- Native SDL2 isn't part of Stride's own runtimes output (it's a separate NuGet
           package); GameContextSDL needs it at load time (see stride-game-studio.md's SDL
           probes - Silk.NET.SDL.GetApi() fails without it on the load path). -->
      <NativeSdl Include="$(NuGetPackageRoot)ultz.native.sdl/2.32.10/runtimes/osx/native/libSDL2-2.0.dylib" Condition="Exists('$(NuGetPackageRoot)ultz.native.sdl/2.32.10/runtimes/osx/native/libSDL2-2.0.dylib')" />
    </ItemGroup>
    <Copy SourceFiles="@(StrideRt)" DestinationFiles="@(StrideRt->'$(OutputPath)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- NativeLibraryHelper.TryFindLibraryPath's first (and most specific) probe is
         Path.Combine(ownerAssemblyDir, "runtimes", "<rid>", "native") - and Stride.Video.dll
         (FFmpegUtils's owner type) lives in the "Vulkan/" per-graphics-API subfolder, not this
         addin's own root, so it needs its own copy of the runtimes tree placed there too. -->
    <Copy SourceFiles="@(StrideRt)" DestinationFiles="@(StrideRt->'$(OutputPath)Vulkan\runtimes\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeSdl)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <!-- The two-way write-back into OpenDevelop's own host bin (previously required here for
         libSDL2-2.0.dylib and libvulkan.1.dylib/MoltenVK_icd.json - "bare-name native loaders only
         probe AppContext.BaseDirectory") is gone. StrideEditorHost's static constructor now
         preloads both dylibs into the process by absolute path (NativeLibrary.Load) before either
         Silk.NET.SDL's own by-name loader or SDL2's internal SDL_Vulkan_LoadLibrary ever runs, so
         the copy is no longer needed. Verified live (2026-08-27): both files removed from
         OpenDevelop's bin, scene editor still starts clean, camera still moves under a real
         right-drag + keydown:w. -->
  </Target>
  <!-- Silk.NET.SDL does not use P/Invoke: it has its own name-based loader, and on macOS that
       tries exactly one name, "libSDL2-2.0.dylib" (SDLLibraryNameContainer.MacOS). dlopen of a
       leaf name only searches dyld's paths and does NOT match an image already loaded under a
       different name - StrideEditorHost's preloading by absolute path therefore does not make
       SDL's own load succeed (measured: the absolute load returns a handle, the immediately
       following leaf load still fails with "no such file"), so Sdl.GetApi() throws and the scene
       viewport never starts. libvulkan.1.dylib escapes this only because its install name already
       IS the bare leaf name. Giving SDL the same shape is what makes the preloading work: once
       the image's install name is "libSDL2-2.0.dylib", dyld matches Silk's leaf request against
       the already-loaded image instead of going to disk. Nothing links against SDL (the .NET side
       only ever loads it dynamically), so rewriting the id breaks no dependent. -->
  <Target Name="NormalizeSdlInstallName" AfterTargets="CopyStrideRuntimes" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup>
      <_SdlDylibForInstallName Include="$(OutputPath)libSDL2-2.0.dylib" />
    </ItemGroup>
    <Exec Command="install_name_tool -id libSDL2-2.0.dylib &quot;@(_SdlDylibForInstallName)&quot;"
          Condition="Exists('@(_SdlDylibForInstallName)')"
          StandardOutputImportance="low" />
    <!-- Rewriting a Mach-O load command invalidates its signature, and on Apple Silicon an
         invalidly-signed dylib is not merely refused: dyld kills the whole process with
         SIGKILL / CODESIGNING "Invalid Page" the first time it is mapped. So the rewrite has to
         be followed by a fresh ad-hoc signature (an identity-based one is only needed if this
         output is ever redistributed outside the developer's own machine). -->
    <Exec Command="codesign --force --sign - &quot;@(_SdlDylibForInstallName)&quot;"
          Condition="Exists('@(_SdlDylibForInstallName)')"
          StandardOutputImportance="low" />
  </Target>
  <!-- Wholesale copy of Stride.GameStudio's own bin output: this is a plain net10.0-windows IL
       folder (AppendRuntimeIdentifierToOutputPath=false), so copying it next to this addin's own
       dll and letting the OpenDevelop host process (already past its own framework-startup gate)
       resolve everything via simple sibling-file probing works, same mechanism already used for
       every other Stride.* reference in this project - see the technote's RID-mismatch finding
       for why this simple-copy approach avoids the cross-RID deps.json issues a *separate*,
       independently-restored process hit when reusing Stride.GameStudio.dll as a live dependency. -->
  <Target Name="CopyGameStudioEditorClosure" AfterTargets="Build">
    <ItemGroup>
      <GameStudioFiles Include="$(StrideRoot)sources\editor\Stride.GameStudio\bin\$(Configuration)\net10.0-windows\**\*" Exclude="$(StrideRoot)sources\editor\Stride.GameStudio\bin\$(Configuration)\net10.0-windows\Stride.GameStudio.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(GameStudioFiles)" DestinationFiles="@(GameStudioFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- A distribution build (-p:OpenDevelopDistributionBuild=true, the .odaddin release package) keeps what an add-in needs on a
       desktop machine and drops the rest. The Stride runtime trees carry every platform Stride supports (about 1.3 GB, copied
       once more under each graphics API folder): only the five desktop RIDs OpenDevelop ships for are kept. Also dropped are
       link-time files nothing loads (.lib, .a, .pdb) and the LibreWPF/ProGPU natives, which the host itself provides. -->
  <Target Name="StrideAddInPruneDistributionPayload" AfterTargets="Build" Condition="'$(OpenDevelopDistributionBuild)' == 'true'">
    <ItemGroup>
      <_StrideDropRid Include="android-arm64;android-x64;ios;ios-arm64;iossimulator;iossimulator-arm64;maccatalyst-arm64;maccatalyst-x64;tvos;tvossimulator;linux-arm;osx-x64;win-x86;browser-wasm" />
      <_StrideDropDirectory Include="@(_StrideDropRid->'$(OutputPath)runtimes/%(Identity)')" />
      <_StrideDropDirectory Include="@(_StrideDropRid->'$(OutputPath)Vulkan/runtimes/%(Identity)')" />
      <_StrideDropDirectory Include="@(_StrideDropRid->'$(OutputPath)Direct3D11/runtimes/%(Identity)')" />
      <_StrideDropDirectory Include="@(_StrideDropRid->'$(OutputPath)Direct3D12/runtimes/%(Identity)')" />
      <_StrideDropDirectory Include="@(_StrideDropRid->'$(OutputPath)OpenGL/runtimes/%(Identity)')" />
      <_StrideDropDirectory Include="@(_StrideDropRid->'$(OutputPath)OpenGLES/runtimes/%(Identity)')" />
      <_StrideDropFile Include="$(OutputPath)**/*.pdb;$(OutputPath)**/*.lib;$(OutputPath)**/*.a" />
      <_StrideDropFile Include="$(OutputPath)**/runtimes/*/native/*progpu*" />
    </ItemGroup>
    <RemoveDir Directories="@(_StrideDropDirectory)" />
    <Delete Files="@(_StrideDropFile)" />
    <RemoveDir Directories="$(OutputPath)runtimes/win-x64/native/sdk;$(OutputPath)runtimes/win-arm64/native/sdk;$(OutputPath)runtimes/linux-x64/native/sdk;$(OutputPath)runtimes/linux-arm64/native/sdk;$(OutputPath)runtimes/osx-arm64/native/sdk" />
  </Target>
  <ItemGroup><None Include="ICSharpCode.StrideGameStudio.addin" /></ItemGroup>
  <Import Project="$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.targets"
          Condition="Exists('$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.targets')" />
  <Import Project="$(OpenDevelopHostBin)Sdks/OpenDevelop.Addin.Sdk/Sdk/Sdk.targets"
          Condition="!Exists('$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.targets') And Exists('$(OpenDevelopHostBin)Sdks/OpenDevelop.Addin.Sdk/Sdk/Sdk.targets')" />
</Project>
