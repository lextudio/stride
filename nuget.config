<?xml version="1.0" encoding="utf-8"?>
<!-- Stride.* engine packages → stride-local only (dev's auto-pack output shadows
     public versions). 3rd-party Stride-prefix packages need explicit nuget.org
     carve-outs below to outrank the Stride.* mapping.

     samples/nuget.config relaxes Stride.* to both feeds for historical versions. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="stride-local" value="bin/packages" />
    <!-- WPF-on-macOS SDK + ProGPU render transport, needed only by
         sources/tools/Stride.OpenDevelop.AddIn. Same local feed OpenDevelop itself uses; see
         OpenDevelop's NuGet.config for how it is produced. -->
    <add key="librewpf-local" value="/Users/lextm/openavalon/artifacts/local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!-- 3rd-party Stride-prefix packages: outrank the Stride.* stride-local mapping. -->
      <package pattern="Stride.GNU.*" />
      <package pattern="Stride.Mono.*" />
      <package pattern="Stride.Dependencies.*" />
      <package pattern="Stride.GraphX.*" />
      <package pattern="Stride.QuickGraph" />
    </packageSource>
    <packageSource key="librewpf-local">
      <package pattern="LibreWPF.*" />
      <package pattern="ProGPU.*" />
      <!-- OpenDevelop's own AvalonEdit build (6.3.2, LibreWPF/ProGPU-based) - the addin needs the
           EXACT version the host ships, not whatever a transitive package graph would otherwise
           pick, since ICSharpCode.SharpDevelop's public surface returns AvalonEdit types by strong
           name (CS1705 otherwise: "uses a higher version than referenced assembly"). -->
      <package pattern="ICSharpCode.AvalonEdit" />
      <!-- The rest of OpenDevelop's compile-time closure for a plain, ordinary addin -
           ICSharpCode.SharpDevelop's own ProjectReference graph. Each is packed the same way
           (dotnet pack <project> -p:Version=5.2.0 -o <this feed>) so the Stride addin no longer
           needs $(OpenDevelopRoot) to point at an OpenDevelop SOURCE checkout for compilation -
           only its built host output ($(OpenDevelopHostBin)) matters at runtime, same as any
           other InProcess addin. -->
      <package pattern="ICSharpCode.SharpDevelop" />
      <package pattern="ICSharpCode.Core" />
      <package pattern="ICSharpCode.Core.Presentation" />
      <package pattern="ICSharpCode.SharpDevelop.Widgets" />
      <package pattern="ICSharpCode.TypeSystem.Abstractions" />
      <package pattern="ICSharpCode.TreeView" />
      <package pattern="ICSharpCode.ILSpyX.TreeView" />
      <package pattern="LeXtudio.OpenDevelop.ResourceFiles" />
      <package pattern="Xceed.Wpf.Toolkit" />
      <package pattern="ICSharpCode.Designer.Remote" />
      <package pattern="ICSharpCode.Designer.Shell" />
    </packageSource>
    <packageSource key="stride-local">
      <package pattern="Stride" />
      <package pattern="Stride.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
